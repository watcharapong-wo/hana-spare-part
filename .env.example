# JWT Secret Key
# สร้าง secret key ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-please-change-this-to-random-string

# Server Port
PORT=3000

# Database File (Optional - default: spareparts.db)
# DB_PATH=./spareparts.db

# Node Environment (development, production)
NODE_ENV=development
