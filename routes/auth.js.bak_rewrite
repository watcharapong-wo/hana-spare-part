const express = require('express');
const router = express.Router();
const jwt = require("jsonwebtoken");\nconsole.log('AUTH_LOADED_MARK', __filename);\n

// POST /auth/login
router.post('/login', (req, res) => {
  const { username, password } = req.body || {};

  if (!username || !password) {
    return res.status(400).json({ message: 'Missing username or password' });
  }

  if (
    (username === 'admin' && password === 'admin123') ||
    (username === 'staff' && password === 'staff123')
  ) {
    return res.json({
      token: jwt.sign({ username, role: username === 'admin' ? 'admin' : 'staff' }, process.env.JWT_SECRET, { expiresIn: '8h' }),
      user: { username, role: username === 'admin' ? 'admin' : 'staff' }
    });
  }

  return res.status(401).json({ message: 'Invalid credentials' });
});

module.exports = router;
